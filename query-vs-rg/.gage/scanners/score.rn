use gage::{
    AgentRunner,
    Files,
    Input,
    Progress,
    Target,
    Template,
    Tool,
    attach,
    call_agent,
    scan,
    write_note,
};

pub const SCANNER = #{
    name: "score",
    description: "Score each case's response against its question's reference answer",
    tasks: #{
        attach_questions: #{ attaches: ["questions"] },
        score_sessions: #{
            attachments: #{ wants: ["questions"] },
            notes: #{
                writes: #{
                    score: "A judge's verdict on one case. The text is the \
                            case name and the reason. Metadata `case` is \
                            the case name, as in `with-gage-1`, `arm` is the \
                            arm it ran under, and `question` is the question \
                            id. `method` says how the case searched: \
                            `gage` for query tool calls alone, `files` \
                            for Bash and Read alone, `both`, or \
                            `none`, with the counts in `bash_calls`, \
                            `read_calls`, `gage_calls`, and `other_calls`. \
                            `correct` says whether the response \
                            states the reference answer, and `evidence` \
                            says whether it cites a session with a quotation \
                            or a line reference. `cost` holds what Claude \
                            Code reports for the case: `ms`, `model_ms`, \
                            `turns`, `tokens_in`, `tokens_out`, `usd`, and \
                            `denied`.",
                },
            },
        },
        tally: #{
            notes: #{
                wants: ["score"],
                writes: #{
                    tally: "The scan's totals for each arm. The text is a \
                            table. Metadata `arms` holds, for each arm, \
                            the counts `cases`, `correct`, `evidence`, and \
                            `pass`, where a pass is a case that is both \
                            correct and has evidence. Metadata \
                            `with_gage_methods` counts the cases of the \
                            `with-gage` \
                            arm by search method. Each arm also holds the \
                            sums `ms`, `turns`, `tokens_in`, `usd`, and \
                            `denied` over its `costed` cases.",
                },
            },
        },
    },
};

const QUESTIONS = "questions.toml";

pub async fn attach_questions() {
    attach(Files::include(QUESTIONS).root("../..")).name("questions").await
}

pub async fn score_sessions() {
    let questions = questions_text().await?;
    let t = Template::new(include_str!("score-prompt.md.j2"))?;

    let sessions = scan().sessions().await;
    let progress = Progress::new(sessions.len());
    let agents = AgentRunner::new();

    for s in sessions {
        let session_id = s.id;
        let question = match case_of(s).await {
            Some(case) => case.question,
            None => {
                log::info!(
                    "skip session {session_id}: project is not <arm>-<question>"
                );
                progress.tick();
                continue;
            }
        };
        // A case that did not complete is not scored. run.py reports such a
        // case and keeps the run incomplete until it has been run again.
        let completed = match case_cost(s).await? {
            Some(cost) => cost.ok,
            None => false,
        };
        if !completed {
            log::warn!("skip session {session_id}: the case did not complete");
            progress.tick();
            continue;
        }
        let response = match final_response(s).await {
            Some(response) => response,
            None => {
                log::info!("skip session {session_id}: no response");
                progress.tick();
                continue;
            }
        };
        let prompt = t.render(#{ session_id, question, questions, response });
        agents.add(
            call_agent(prompt).name("score").tool(score_tool()).model("medium"),
            #{ session_id },
        );
    }

    let failed = 0;
    let results = agents.start();
    while let Some(next) = results.next().await {
        match next {
            Ok((result, #{ session_id })) => {
                log::info!(
                    "agent result: {:?}",
                    #{
                        session: session_id,
                        result: result.text,
                        metadata: result.metadata(),
                    },
                );
            }
            Err(err) => {
                failed += 1;
                log::error!("agent error: {err:?}");
            }
        }
        progress.tick();
    }
    if failed > 0 {
        return Err(format!("{failed} judge agents failed; their cases have no score"));
    }
    Ok(())
}

// The text of the attached question file
async fn questions_text() {
    for a in scan().attachments().name("questions").await? {
        if let Some(f) = a.file(QUESTIONS).await {
            return Ok(f.text()?);
        }
    }
    Err(format!("no attachment holds {QUESTIONS}"))
}

// The case a session records. A case's project is `<arm>-<question>`,
// as in `with-gage-1`, which is also the case's name. The
// question is what follows the last `-`, and the arm is the rest.
async fn case_of(s) {
    let name = s.attrs().await.project?;
    let parts = name.split('-').collect::<Vec>();
    if parts.len() < 2 {
        return None;
    }
    let question = parts.pop()?;
    Some(#{ name, arm: parts.join("-"), question })
}

// The case's response: every final message the agent gave, in order.
// A case usually has one. It has more when the agent ended a turn while a
// background task was running and was resumed afterward, and the answer
// can then be in any of them. `None` when no final message has text.
async fn final_response(s) {
    let parts = [];
    for e in s.entries().await {
        if e.type != "result" {
            continue;
        }
        let r = json::parse(e.raw).ok()?;
        if let Some(text) = r.get("result") {
            if text is String && !text.trim().is_empty() {
                parts.push(text);
            }
        }
    }
    if parts.is_empty() {
        return None;
    }
    Some(parts.join("\n\n[next final message]\n\n"))
}

// The number of Bash calls, Gage query calls, and calls to any other
// tool, such as Read, that the case made
async fn tool_calls(s) {
    let calls = #{ bash: 0, read: 0, gage: 0, other: 0, errors: 0 };
    for t in s.tool_uses().await {
        if t.is_error == Some(true) {
            calls.errors += 1;
        }
        if t.name == "Bash" {
            calls.bash += 1;
        } else if t.name == "Read" {
            calls.read += 1;
        } else if t.name.ends_with("gage__query") {
            calls.gage += 1;
        } else {
            calls.other += 1;
        }
    }
    calls
}

// How the case searched: `gage` for the query tool alone, `files` for
// Bash and Read alone, `both`, or `none`. A call to any other tool, such
// as a lookup of a tool's definition, is not a search.
fn method(calls) {
    let files = calls.bash + calls.read;
    if files > 0 && calls.gage > 0 {
        "both"
    } else if files > 0 {
        "files"
    } else if calls.gage > 0 {
        "gage"
    } else {
        "none"
    }
}

fn score_tool() {
    Tool::new("score", write_score)
        .description("Record the verdict on the response")
        .input(Input::string("session_id").required())
        .input(
            Input::boolean("correct")
                .description(
                    "True when the response states what the reference \
                     answer states",
                )
                .required(),
        )
        .input(
            Input::boolean("evidence")
                .description(
                    "True when the response cites at least one of the \
                     question's sessions with a quotation or a line \
                     reference that supports the answer",
                )
                .required(),
        )
        .input(
            Input::string("reason")
                .description("One or two sentences that justify both values")
                .required(),
        )
}

pub async fn write_score(inputs) {
    // The judge supplies only the verdict. The case comes from the
    // session, so the note cannot name the wrong case.
    let case = None;
    let calls = #{ bash: 0, read: 0, gage: 0, other: 0, errors: 0 };
    let cost = None;
    for s in scan().sessions().await {
        if s.id == inputs.session_id {
            case = case_of(s).await;
            calls = tool_calls(s).await;
            cost = case_cost(s).await?;
        }
    }
    let cost = cost.unwrap_or(#{});
    let case = match case {
        Some(case) => case,
        None => {
            return Ok(
                format!("error: `{}` is not a case of this scan", inputs.session_id),
            );
        }
    };
    let note = write_note("score", format!("{}: {}", case.name, inputs.reason))
        .target(Target::session(inputs.session_id))
        .metadata(
            #{
                case: case.name,
                arm: case.arm,
                question: case.question,
                method: method(calls),
                bash_calls: calls.bash,
                read_calls: calls.read,
                gage_calls: calls.gage,
                other_calls: calls.other,
                tool_errors: calls.errors,
                correct: inputs.correct,
                evidence: inputs.evidence,
                cost,
            },
        )
        .await?;
    Ok(format!("Wrote score note {}", note.id))
}

// What the case cost, as Claude Code reports it in the case's final
// `result` entry: `ms` is the whole case and `model_ms` the part spent
// waiting on the model. `None` when the case has no such entry.
async fn case_cost(s) {
    let cost = None;
    let wall_ms = None;
    for e in s.entries().await {
        if e.type == "case_summary" {
            wall_ms = Some(json::parse(e.raw)?.wall_ms);
        }
        if e.type != "result" {
            continue;
        }
        // A session has more than one result when the agent ended a turn
        // while a background task was running and was resumed afterward.
        // Time, turns, tokens, and denials are per result, so they are
        // summed. Model time and cost are cumulative, so the last stands.
        let r = json::parse(e.raw)?;
        let u = r.usage;
        let c = match cost {
            Some(earlier) => earlier,
            None => #{ ms: 0, turns: 0, tokens_in: 0, tokens_out: 0, denied: 0 },
        };
        cost = Some(
            #{
                ok: r.subtype == "success" && !r.is_error,
                ms: c.ms + r.duration_ms,
                model_ms: r.duration_api_ms,
                turns: c.turns + r.num_turns,
                tokens_in: c.tokens_in
                    + u.input_tokens
                    + u.cache_creation_input_tokens
                    + u.cache_read_input_tokens,
                tokens_out: c.tokens_out + u.output_tokens,
                usd: r.total_cost_usd,
                denied: c.denied + r.permission_denials.len(),
            },
        );
    }
    // run.py records the wall time of the case, which also covers the wait
    // for a background task. It stands in place of the summed result times.
    match cost {
        Some(total) => {
            if let Some(ms) = wall_ms {
                total.ms = ms;
            }
            Ok(Some(total))
        }
        None => Ok(None),
    }
}

// The arms in the order the table lists them. An arm not named here
// follows them.
const ARMS = ["default-claude", "with-rg", "with-gage"];

/// Total the scan's score notes for each arm and write one tally note.
pub async fn tally() {
    let scores = scan().notes().name("score").await?;

    // Every completed case must have exactly one score. A judge that did
    // not record its verdict leaves a case without one, and a tally over
    // the rest would misstate the results.
    let scored = #{};
    for n in scores {
        let name = format!("{}", n.metadata.case);
        scored.insert(name.clone(), scored.get(name).unwrap_or(0) + 1);
    }
    let problems = [];
    for s in scan().sessions().await {
        let case = match case_of(s).await {
            Some(case) => case,
            None => continue,
        };
        let completed = match case_cost(s).await? {
            Some(cost) => cost.ok,
            None => false,
        };
        let count = scored.get(case.name).unwrap_or(0);
        if completed && count != 1 {
            problems.push(format!("{} has {} scores", case.name, count));
        }
    }
    if !problems.is_empty() {
        return Err(format!("cannot tally: {}", problems.join(", ")));
    }

    let arms = #{};
    let extra = [];
    let with_gage_methods = #{};

    for n in scores {
        let m = n.metadata;
        // Copies, because inserting a value into a map takes it
        let arm = format!("{}", m.arm);
        let method = format!("{}", m.method);
        if arms.get(arm).is_none() {
            arms.insert(
                arm.clone(),
                #{
                    cases: 0,
                    correct: 0,
                    evidence: 0,
                    pass: 0,
                    costed: 0,
                    ms: 0,
                    turns: 0,
                    tokens_in: 0,
                    usd: 0.0,
                    denied: 0,
                    tool_errors: 0,
                },
            );
            if !ARMS.iter().any(|a| a == arm) {
                extra.push(arm.clone());
            }
        }
        let a = arms[arm];
        a.cases += 1;
        a.tool_errors += m.tool_errors;
        if m.correct {
            a.correct += 1;
        }
        if m.evidence {
            a.evidence += 1;
        }
        if m.correct && m.evidence {
            a.pass += 1;
        }
        if let Some(ms) = m.cost.get("ms") {
            a.costed += 1;
            a.ms += ms;
            a.turns += m.cost.turns;
            a.tokens_in += m.cost.tokens_in;
            a.usd += m.cost.usd as f64;
            a.denied += m.cost.denied;
        }
        if arm == "with-gage" {
            let count = with_gage_methods.get(method).unwrap_or(0);
            with_gage_methods.insert(method.clone(), count + 1);
        }
    }

    let lines = [
        "| Arm | Cases | Correct | Evidence | Pass | Seconds | Turns | Tokens in | Cost | Tool errors | Denied |",
        "|---|---|---|---|---|---|---|---|---|---|---|",
    ];
    let order = ARMS.iter().collect::<Vec>();
    order.extend(extra);
    for arm in order {
        if let Some(a) = arms.get(arm) {
            // Means over the cases that report a cost
            let n = if a.costed > 0 { a.costed as f64 } else { 1.0 };
            lines.push(
                format!(
                    "| {} | {} | {} | {} | {} | {} | {} | {} | ${} | {} | {} |",
                    arm,
                    a.cases,
                    a.correct,
                    a.evidence,
                    a.pass,
                    round(a.ms as f64 / 1000.0 / n, 1.0),
                    round(a.turns as f64 / n, 10.0),
                    round(a.tokens_in as f64 / n, 1.0),
                    round(a.usd / n, 100.0),
                    round(a.tool_errors as f64 / a.cases as f64, 10.0),
                    round(a.denied as f64 / n, 10.0),
                ),
            );
        }
    }
    lines.push("");
    lines.push("A pass is a case that is both correct and has evidence.");
    lines.push("Seconds, turns, tokens in, cost, tool errors, and denied calls are means per case.");
    lines.push("A tool error is a call that returned an error. A denied call is one of them, refused before it ran.");
    for method in ["gage", "files", "both", "none"] {
        if let Some(count) = with_gage_methods.get(method) {
            lines.push(format!("Cases of the with-gage arm that searched with {method}: {count}"));
        }
    }

    let note = write_note("tally", lines.join("\n"))
        .metadata(#{ arms, with_gage_methods })
        .await?;
    log::info!("wrote tally note {}", note.id);
}

// `x` rounded to a multiple of `1 / scale`
fn round(x, scale) {
    (x * scale).round() / scale
}
