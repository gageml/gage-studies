use gage::{
    AgentRunner,
    Files,
    Input,
    Progress,
    Target,
    Template,
    Tool,
    attach,
    call_agent,
    scan,
    write_note,
};

pub const SCANNER = #{
    name: "score",
    description: "Score each run's response against its question's reference answer",
    tasks: #{
        attach_questions: #{ attaches: ["questions"] },
        score_sessions: #{
            attachments: #{ wants: ["questions"] },
            notes: #{
                writes: #{
                    score: "A judge's verdict on one run. The text is the \
                            run name and the reason. Metadata `run` is \
                            the run name, as in `rg-1`, `arm` is the \
                            arm it ran under, and `question` is the question \
                            id. `method` says how the run searched: \
                            `rg` for Bash calls alone, `gage` for query \
                            tool calls alone, `both`, or `none`, with \
                            the counts in `bash_calls` and `gage_calls`. \
                            `correct` says whether the response \
                            states the reference answer, and `evidence` \
                            says whether it cites a session with a quotation \
                            or a line reference. `cost` holds what Claude \
                            Code reports for the run: `ms`, `model_ms`, \
                            `turns`, `tokens_in`, `tokens_out`, `usd`, and \
                            `denied`.",
                },
            },
        },
        tally: #{
            notes: #{
                wants: ["score"],
                writes: #{
                    tally: "The scan's totals for each arm. The text is a \
                            table. Metadata `arms` holds, for each arm, \
                            the counts `runs`, `correct`, `evidence`, and \
                            `pass`, where a pass is a run that is both \
                            correct and has evidence. Metadata \
                            `both_methods` counts the runs of the `both` \
                            arm by search method. Each arm also holds the \
                            sums `ms`, `turns`, `tokens_in`, `usd`, and \
                            `denied` over its `costed` runs.",
                },
            },
        },
    },
};

const QUESTIONS = "questions.toml";

pub async fn attach_questions() {
    attach(Files::include(QUESTIONS).root("../..")).name("questions").await
}

pub async fn score_sessions() {
    let questions = questions_text().await?;
    let t = Template::new(include_str!("score-prompt.md.j2"))?;

    let sessions = scan().sessions().await;
    let progress = Progress::new(sessions.len());
    let agents = AgentRunner::new();

    for s in sessions {
        let session_id = s.id;
        let question = match run_of(s).await {
            Some(run) => run.question,
            None => {
                log::info!(
                    "skip session {session_id}: project is not <arm>-<question>"
                );
                progress.tick();
                continue;
            }
        };
        let response = match final_response(s).await {
            Some(response) => response,
            None => {
                log::info!("skip session {session_id}: no response");
                progress.tick();
                continue;
            }
        };
        let prompt = t.render(#{ session_id, question, questions, response });
        agents.add(
            call_agent(prompt).name("score").tool(score_tool()).model("medium"),
            #{ session_id },
        );
    }

    let results = agents.start();
    while let Some(next) = results.next().await {
        match next {
            Ok((result, #{ session_id })) => {
                log::info!(
                    "agent result: {:?}",
                    #{
                        session: session_id,
                        result: result.text,
                        metadata: result.metadata(),
                    },
                );
            }
            Err(err) => {
                log::error!("agent error: {err:?}");
            }
        }
        progress.tick();
    }
}

// The text of the attached question file
async fn questions_text() {
    for a in scan().attachments().name("questions").await? {
        if let Some(f) = a.file(QUESTIONS).await {
            return Ok(f.text()?);
        }
    }
    Err(format!("no attachment holds {QUESTIONS}"))
}

// The run a session records. A run's project is `<arm>-<question>`,
// as in `rg-1` or `rg-hint-1`, which is also the run's name. The
// question is what follows the last `-`, and the arm is the rest.
async fn run_of(s) {
    let name = s.attrs().await.project?;
    let parts = name.split('-').collect::<Vec>();
    if parts.len() < 2 {
        return None;
    }
    let question = parts.pop()?;
    Some(#{ name, arm: parts.join("-"), question })
}

// The run's final response: its last assistant text message
async fn final_response(s) {
    let response = None;
    for m in s.messages().await {
        if m.type == "assistant" && m.subtype == Some("text") {
            response = Some(m.text);
        }
    }
    response
}

// The number of Bash calls and Gage query calls the run made
async fn tool_calls(s) {
    let calls = #{ bash: 0, gage: 0 };
    for t in s.tool_uses().await {
        if t.name == "Bash" {
            calls.bash += 1;
        } else if t.name.contains("gage") {
            calls.gage += 1;
        }
    }
    calls
}

// How the run searched: `rg` for Bash alone, `gage` for the query tool
// alone, `both`, or `none`
fn method(calls) {
    if calls.bash > 0 && calls.gage > 0 {
        "both"
    } else if calls.bash > 0 {
        "rg"
    } else if calls.gage > 0 {
        "gage"
    } else {
        "none"
    }
}

fn score_tool() {
    Tool::new("score", write_score)
        .description("Record the verdict on the response")
        .input(Input::string("session_id").required())
        .input(
            Input::boolean("correct")
                .description(
                    "True when the response states what the reference \
                     answer states",
                )
                .required(),
        )
        .input(
            Input::boolean("evidence")
                .description(
                    "True when the response cites at least one of the \
                     question's sessions with a quotation or a line \
                     reference that supports the answer",
                )
                .required(),
        )
        .input(
            Input::string("reason")
                .description("One or two sentences that justify both values")
                .required(),
        )
}

pub async fn write_score(inputs) {
    // The judge supplies only the verdict. The run comes from the
    // session, so the note cannot name the wrong run.
    let run = None;
    let calls = #{ bash: 0, gage: 0 };
    let cost = None;
    for s in scan().sessions().await {
        if s.id == inputs.session_id {
            run = run_of(s).await;
            calls = tool_calls(s).await;
            cost = run_cost(s).await?;
        }
    }
    let cost = cost.unwrap_or(#{});
    let run = match run {
        Some(run) => run,
        None => {
            return Ok(
                format!("error: `{}` is not a run of this scan", inputs.session_id),
            );
        }
    };
    let note = write_note("score", format!("{}: {}", run.name, inputs.reason))
        .target(Target::session(inputs.session_id))
        .metadata(
            #{
                run: run.name,
                arm: run.arm,
                question: run.question,
                method: method(calls),
                bash_calls: calls.bash,
                gage_calls: calls.gage,
                correct: inputs.correct,
                evidence: inputs.evidence,
                cost,
            },
        )
        .await?;
    Ok(format!("Wrote score note {}", note.id))
}

// What the run cost, as Claude Code reports it in the run's final
// `result` entry: `ms` is the whole run and `model_ms` the part spent
// waiting on the model. `None` when the run has no such entry.
async fn run_cost(s) {
    let cost = None;
    for e in s.entries().await {
        if e.type != "result" {
            continue;
        }
        let r = json::parse(e.raw)?;
        let u = r.usage;
        cost = Some(
            #{
                ms: r.duration_ms,
                model_ms: r.duration_api_ms,
                turns: r.num_turns,
                tokens_in: u.input_tokens
                    + u.cache_creation_input_tokens
                    + u.cache_read_input_tokens,
                tokens_out: u.output_tokens,
                usd: r.total_cost_usd,
                denied: r.permission_denials.len(),
            },
        );
    }
    Ok(cost)
}

// The arms in the order the table lists them. An arm not named here
// follows them.
const ARMS = ["rg", "rg-hint", "gage", "both"];

/// Total the scan's score notes for each arm and write one tally note.
pub async fn tally() {
    let scores = scan().notes().name("score").await?;
    let arms = #{};
    let extra = [];
    let both_methods = #{};

    for n in scores {
        let m = n.metadata;
        // Copies, because inserting a value into a map takes it
        let arm = format!("{}", m.arm);
        let method = format!("{}", m.method);
        if arms.get(arm).is_none() {
            arms.insert(
                arm.clone(),
                #{
                    runs: 0,
                    correct: 0,
                    evidence: 0,
                    pass: 0,
                    costed: 0,
                    ms: 0,
                    turns: 0,
                    tokens_in: 0,
                    usd: 0.0,
                    denied: 0,
                },
            );
            if !ARMS.iter().any(|a| a == arm) {
                extra.push(arm.clone());
            }
        }
        let a = arms[arm];
        a.runs += 1;
        if m.correct {
            a.correct += 1;
        }
        if m.evidence {
            a.evidence += 1;
        }
        if m.correct && m.evidence {
            a.pass += 1;
        }
        if let Some(ms) = m.cost.get("ms") {
            a.costed += 1;
            a.ms += ms;
            a.turns += m.cost.turns;
            a.tokens_in += m.cost.tokens_in;
            a.usd += m.cost.usd as f64;
            a.denied += m.cost.denied;
        }
        if arm == "both" {
            let count = both_methods.get(method).unwrap_or(0);
            both_methods.insert(method.clone(), count + 1);
        }
    }

    let lines = [
        "| Arm | Runs | Correct | Evidence | Pass | Seconds | Turns | Tokens in | Cost | Denied |",
        "|---|---|---|---|---|---|---|---|---|---|",
    ];
    let order = ARMS.iter().collect::<Vec>();
    order.extend(extra);
    for arm in order {
        if let Some(a) = arms.get(arm) {
            // Means over the runs that report a cost
            let n = if a.costed > 0 { a.costed as f64 } else { 1.0 };
            lines.push(
                format!(
                    "| {} | {} | {} | {} | {} | {} | {} | {} | ${} | {} |",
                    arm,
                    a.runs,
                    a.correct,
                    a.evidence,
                    a.pass,
                    round(a.ms as f64 / 1000.0 / n, 1.0),
                    round(a.turns as f64 / n, 10.0),
                    round(a.tokens_in as f64 / n, 1.0),
                    round(a.usd / n, 100.0),
                    round(a.denied as f64 / n, 10.0),
                ),
            );
        }
    }
    lines.push("");
    lines.push("A pass is a run that is both correct and has evidence.");
    lines.push("Seconds, turns, tokens in, cost, and denied calls are means per run.");
    for method in ["rg", "gage", "both", "none"] {
        if let Some(count) = both_methods.get(method) {
            lines.push(format!("Runs of the both arm that searched with {method}: {count}"));
        }
    }

    let note = write_note("tally", lines.join("\n"))
        .metadata(#{ arms, both_methods })
        .await?;
    log::info!("wrote tally note {}", note.id);
}

// `x` rounded to a multiple of `1 / scale`
fn round(x, scale) {
    (x * scale).round() / scale
}
